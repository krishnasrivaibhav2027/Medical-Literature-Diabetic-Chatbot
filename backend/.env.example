# ==========================================
# Hybrid RAG Medical Assistant - Backend Config
# ==========================================

# Application Metadata
APP_NAME="Medical Literature Assistant"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL + pgvector)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/HybridRAG

# Security & JWT Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=90
SECRET_KEY=generate-a-secure-random-secret-key-for-jwt-tokens

# CORS Allowed Origins (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Upstream LLM Proxy (XKiro / OpenAI compatible)
XKIRO_API_KEY=your_xkiro_api_key_here

# Hugging Face & NVIDIA (Optional fallback providers)
HUGGING_FACE_TOKEN=your_huggingface_token_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Upstash Redis (Semantic Cache, QA Cache, Embedding Cache, Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Jina AI Serverless Reranker
JINA_API_KEY=your_jina_api_key_here
JINA_RERANKER_MODEL=jina-reranker-v3.5
JINA_URL=https://api.jina.ai/v1/rerank

# LangSmith Observability & Tracing (Optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Medical-Literature-RAG-Assistant-production
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Medical-Literature-RAG-Assistant-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
